<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_headline"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvLensTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_choose_lens"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/rgLens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbLens1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lens_24_70"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbLens2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lens_24_105" />

            <RadioButton
                android:id="@+id/rbLens3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lens_50" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbFiltr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_filter" />

        <CheckBox
            android:id="@+id/cbClean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_cleaning" />

        <CheckBox
            android:id="@+id/cbWarranty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_warranty" />

        <!-- Horizontální rozložení pro tlačítka Objednat a Sdílet vedle sebe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_order" />

            <!-- Skryté tlačítko pro sdílení, ukáže se až po objednání -->
            <Button
                android:id="@+id/btnShare"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Sdílet"
                android:textColor="#6200EE"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:text="@string/tv_summary_default"
            android:background="#F5F3FF"
            android:padding="12dp"
            android:layout_marginTop="20dp" />

        <ImageView
            android:id="@+id/ivLens"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/rf24_70"
            android:scaleType="fitCenter"
            android:contentDescription="@string/title_headline" />

    </LinearLayout>
</ScrollView>